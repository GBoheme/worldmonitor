{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GBoheme Intelligence",
  "identifier": "app.gboheme.intelligence",
  "app": {
    "windows": [
      {
        "title": "GBoheme Intelligence",
        "url": "index.html?intelligence=1",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "shortDescription": "GBoheme Intelligence — personal news workspace built on World Monitor",
    "icon": [
      "icons/gboheme.png",
      "icons/gboheme.ico"
    ]
  },
  "build": {
    "frontendDist": "../dist-gboheme-desktop",
    "beforeBuildCommand": "npm run build:desktop -- --outDir dist-gboheme-desktop"
  }
}
