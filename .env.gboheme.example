# Optional GBoheme settings. Merge chosen values into the existing root .env.local.
# Basic classification, saved news, GitHub releases and drafts need no AI key.
VITE_VARIANT=full
# Existing API and source entitlements still apply. Local web dev uses same-origin handlers.
VITE_WS_API_URL=https://api.worldmonitor.app
# Backend/local model only; these values are NOT exposed in the Vite bundle.
OLLAMA_API_URL=
OLLAMA_MODEL=
# Use the complete .env.example for optional Clerk, Convex and provider configuration.
# Keep OAuth access tokens and private provider keys on a server/native secure store.
# Social read/publish integrations are not implemented in this beta.
